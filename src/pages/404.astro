---
// HAND-WRITTEN — not produced by scripts/generate_pages.mjs. Do not delete this
// with `rm src/pages/*.astro` when regenerating; that only rewrites the nine
// legacy pages and will silently drop this file.
//
// GitHub Pages serves this automatically for any unmatched path. Previously a
// mistyped URL showed the stock GitHub 404, which is off-brand and confusing
// for a buyer following a stale link from an email.
//
// Uses the legacy visual language deliberately — step 2 is structural only.
import Layout from '../layouts/Layout.astro';
import tail from '../content/legacy/tail/about.html?raw';
---

<Layout
  title="Page Not Found | Three Stars Fashion"
  description="The page you requested could not be found. Browse our manufacturing capabilities, facilities and certifications, or contact Three Stars Fashion directly."
  canonical="https://threestarsfashion.com/404"
  ogTitle="Page Not Found | Three Stars Fashion"
  ogDescription="The page you requested could not be found."
  ogUrl="https://threestarsfashion.com/404"
  twitterTitle="Page Not Found | Three Stars Fashion"
  twitterDescription="The page you requested could not be found."
  pagesCss={true}
>
    <section class="page-hero">
        <div class="page-hero-bg">
            <div class="page-hero-gradient"></div>
        </div>
        <div class="page-hero-content">
            <span class="page-label reveal-up">ERROR 404</span>
            <h1 class="page-title reveal-up">Page Not Found</h1>
            <p class="page-subtitle reveal-up">The page you requested doesn't exist or has moved.</p>
        </div>
    </section>

    <section class="content-section">
        <div class="content-container">
            <div class="content-text">
                <h2 class="section-title">Where would you like to go?</h2>
                <p>If you followed a link to get here, it may be out of date. These are the
                    pages sourcing, merchandising and compliance teams use most:</p>
                <ul>
                    <li><a href="/about">About Three Stars Fashion</a> — group structure, leadership and history</li>
                    <li><a href="/services">Services</a> — cutting, sewing, printing, embroidery and development</li>
                    <li><a href="/facilities">Our Facilities</a> — buildings, departments and factory audits</li>
                    <li><a href="/certifications">Certifications</a> — compliance and buyer approvals</li>
                    <li><a href="/logistics">Logistics</a> — Green Point Logistics and duty-free export</li>
                    <li><a href="/faq">FAQ</a> — lead times, sourcing and trade agreements</li>
                    <li><a href="/contact">Contact</a> — submit an inquiry or request documentation</li>
                </ul>
            </div>
        </div>
    </section>

  <Fragment slot="tail" set:html={tail} />
</Layout>
