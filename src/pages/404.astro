---
// HAND-WRITTEN — not produced by any generator.
//
// GitHub Pages serves this automatically for any unmatched path. Previously a
// mistyped URL showed the stock GitHub 404, which is off-brand and confusing for
// a buyer following a stale link from an email.
import SiteLayout from '../layouts/SiteLayout.astro';
import Band from '../components/ds/Band.astro';
import PageHead from '../components/ds/PageHead.astro';
import Button from '../components/ds/Button.astro';

const ROUTES = [
  { href: '/about', label: 'About Three Stars Fashion', note: 'Group structure, leadership and history' },
  { href: '/services', label: 'Capability', note: 'Cutting, sewing, printing, embroidery and development' },
  { href: '/facilities', label: 'Our Facilities', note: 'Buildings, departments and factory audits' },
  { href: '/certifications', label: 'Certifications', note: 'Compliance and buyer approvals' },
  { href: '/logistics', label: 'Logistics', note: 'Green Point Logistics and duty-free export' },
  { href: '/faq', label: 'FAQ', note: 'Lead times, sourcing and trade agreements' },
  { href: '/contact', label: 'Contact', note: 'Submit an inquiry or request documentation' },
];
---

<SiteLayout
  title="Page Not Found | Three Stars Fashion"
  description="The page you requested could not be found. Browse our manufacturing capabilities, facilities and certifications, or contact Three Stars Fashion directly."
  canonical="https://threestarsfashion.com/404"
  ogTitle="Page Not Found | Three Stars Fashion"
  ogDescription="The page you requested could not be found."
  ogUrl="https://threestarsfashion.com/404"
  twitterTitle="Page Not Found | Three Stars Fashion"
  twitterDescription="The page you requested could not be found."
  activeNav={null}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <PageHead
    eyebrow="Error 404"
    title="Page not found"
    standfirst="The page you requested doesn't exist or has moved. If you followed a link to get here, it may be out of date."
  />

  <Band surface="page">
    <ul class="routes">
      {ROUTES.map((r) => (
        <li class="route">
          <a href={r.href} class="route__link">{r.label}</a>
          <p class="route__note">{r.note}</p>
        </li>
      ))}
    </ul>
    <div class="more">
      <Button href="/" arrow>Back to the overview</Button>
    </div>
  </Band>
</SiteLayout>

<style>
  .routes {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--container-text);
    border-top: var(--border-mid) solid var(--rule-strong);
  }
  .route {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-5);
    border-bottom: var(--border-hair) solid var(--rule-hair);
  }
  .route__link {
    font-family: var(--font-display);
    font-size: var(--fs-heading-2);
    font-weight: var(--weight-semibold);
    color: var(--text-display);
    text-decoration: none;
  }
  .route__link:hover { color: var(--text-accent); text-decoration: underline; text-underline-offset: 3px }
  .route__note { font-size: var(--fs-body-sm); color: var(--text-muted) }
  .more { margin-top: var(--space-12) }
</style>
