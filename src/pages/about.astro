---
/**
 * About. No design reference existed for this page, so it is composed from
 * system primitives. Content-first, no video, minimal motion.
 *
 * Every claim from legacy/about.html is preserved: group companies, product
 * range, the flat-seam inventory claim, all four values, Vision 2030 and all
 * four named leaders. Head tags ported verbatim.
 *
 * ONE CONTENT CHANGE, resolved in PARITY.md §5: the solar commitment read
 * "70-80% solar power by 2026", which is now due or past. Restated as 2030 under
 * Vision 2030, range unchanged.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import MediaSlot from '../components/MediaSlot.astro';
import Band from '../components/ds/Band.astro';
import PageHead from '../components/ds/PageHead.astro';
import SectionHeading from '../components/ds/SectionHeading.astro';
import SpecTable from '../components/ds/SpecTable.astro';
import ValueCard from '../components/ds/ValueCard.astro';
import Button from '../components/ds/Button.astro';
import CalloutBand from '../components/ds/CalloutBand.astro';
import { GROUP_COMPANIES } from '../data/site';

const VALUES = [
  {
    label: 'Sustainability',
    title: 'Renewable energy and materials',
    body: 'Committed to reducing our environmental footprint through eco-friendly practices and the use of sustainable materials and energy. We are transitioning to 70–80% solar power by 2030.',
  },
  {
    label: 'Innovation',
    title: 'Automation and process engineering',
    body: 'Continuously investing in manufacturing technology, process automation, and production engineering to maintain efficiency and quality standards across high-volume, multi-category programs.',
  },
  {
    label: 'Ethical practices',
    title: 'Fair labor and community',
    body: 'Upholding fair labor practices and contributing to the well-being of our employees and communities. We actively support local communities through food programs and healthcare partnerships.',
  },
  {
    label: 'Partnership',
    title: 'Dedicated account management',
    body: "Prioritizing partner requirements across every stage of engagement — from initial sampling and development through bulk production, quality assurance, and on-time delivery. We maintain transparent communication and dedicated account management for all active programs.",
  },
] as const;

const LEADERSHIP = [
  { label: 'Zakir Hossain', value: 'Founder & Chairman' },
  { label: 'Ziad Zakir', value: 'Chief Executive Officer' },
  { label: 'Ahmed Mahran', value: 'General Manager' },
  { label: 'Tarek Gaber', value: 'Chief Marketing Officer' },
] as const;

const CATEGORIES = [
  { label: 'Activewear & athletics', value: 'Hoodies, leggings, sports bras, rash guards, soft-shell jackets' },
  { label: 'Casualwear', value: 'T-shirts, polos, pants, dresses, outerwear' },
  { label: 'Uniforms & underwear', value: 'Scrubs, team uniforms, boxers, nightwear' },
  { label: 'Segments', value: "Men's, ladies', kids'" },
] as const;
---

<SiteLayout
  title="About Us | Three Stars Fashion - Leading Apparel Manufacturer in Egypt"
  description="Learn about Three Stars Fashion Group, one of Egypt's largest apparel manufacturers. Established in 2008, TSF operates 10 factories with 3,100+ machines. Vertically integrated garment manufacturing with in-house design, cutting, sewing, printing, and logistics."
  canonical="https://threestarsfashion.com/about"
  ogTitle="About Three Stars Fashion | Egypt Garment Manufacturer"
  ogDescription="One of Egypt's largest apparel manufacturers since 2008. 10 factories, 3,100+ machines, fully vertically integrated from design to export."
  ogUrl="https://threestarsfashion.com/about"
  twitterTitle="About Three Stars Fashion | Egypt Garment Manufacturer"
  twitterDescription="One of Egypt's largest apparel manufacturers since 2008. 10 factories, 3,100+ machines, fully vertically integrated from design to export."
  activeNav="/about"
>
  <PageHead
    eyebrow="About us"
    lead="Vertically integrated"
    title="manufacturing since 2008"
    standfirst="Three Stars Fashion Group (TSF) is a pioneering garment manufacturing company and prominent apparel exporter based in Alexandria, Egypt, specializing in high-quality knitted and woven garments for globally recognized brands and retailers."
  />

  <Band surface="page">
    <div class="two">
      <div class="prose">
        <p>
          Driven by innovation, sustainability, and social responsibility, we combine
          advanced manufacturing technology with skilled production capabilities across
          our state-of-the-art facilities. Our vertically integrated structure allows us
          to deliver consistent quality, competitive lead times, and scalable production
          solutions tailored to our partners' needs.
        </p>
        <p>
          Our group of companies includes Three Stars Fashion, Three Stars Apparels,
          Golden Stars Textile, and Green Point Logistics. Together, we are ranked as one
          of the largest apparel manufacturers and exporters in Egypt.
        </p>
        <p>
          Our product range spans activewear and athletics, casualwear, uniforms, and
          underwear — covering men's, ladies', and kids' categories. Supported by one of
          the largest flat-seam machine inventories in Egypt, we are particularly
          recognized for our expertise in performance and athletic garments.
        </p>
      </div>
      <div class="aside">
        <SpecTable caption="Group companies" numericValues={false} rows={GROUP_COMPANIES} />
        <MediaSlot
          dir="assets/Buildings"
          basename="TSF Building (B)"
          alt="Three Stars Fashion Building B, Alexandria Free Zone"
          aspectRatio="16 / 10"
          quiet
        />
      </div>
    </div>
  </Band>

  <Band surface="sunken">
    <SectionHeading
      size="display-3"
      eyebrow="Product range"
      lead="Four categories,"
      title="three segments"
    />
    <div class="aside aside--wide">
      <SpecTable caption="Categories" numericValues={false} rows={CATEGORIES} />
    </div>
  </Band>

  <Band surface="page">
    <SectionHeading
      size="display-3"
      eyebrow="What we hold to"
      lead="Four commitments,"
      title="audited not asserted"
    />
    <div class="grid-4">
      {VALUES.map((v) => <ValueCard label={v.label} title={v.title} body={v.body} />)}
    </div>
  </Band>

  <Band surface="navy" grid>
    <div class="two">
      <SectionHeading
        size="display-3"
        eyebrow="Vision 2030"
        lead="A global leader in"
        title="sustainable apparel manufacturing"
        standfirst="Setting new benchmarks in operational efficiency, environmental stewardship, and social responsibility. We are advancing the standards of how garments are manufactured at scale."
        onDark
      />
      <div class="prose prose--dark">
        <p>
          Looking ahead, Three Stars Fashion Group is focused on expanded manufacturing
          capacity and automation, deeper integration of renewable energy, broader
          adoption of recycled and organic materials, expansion into new global markets,
          and continued investment in technology, people, and compliance.
        </p>
      </div>
    </div>
  </Band>

  <Band surface="page">
    <div class="two">
      <SectionHeading
        size="display-3"
        eyebrow="Leadership"
        lead="An experienced"
        title="management team"
        standfirst="Three Stars Fashion Group is led by an experienced management team with deep expertise in manufacturing, exports, and global brand partnerships."
      />
      <div class="aside">
        <SpecTable caption="Management" numericValues={false} rows={LEADERSHIP} />
      </div>
    </div>
    <div class="more">
      <Button href="/facilities" variant="secondary" arrow>See the facilities</Button>
    </div>
  </Band>

  <CalloutBand
    eyebrow="Next step"
    title="Evaluating a new manufacturing partner?"
    body="Send volumes, categories and target ex-factory dates. You will get a capacity answer and a compliance pack, not a brochure."
    actionLabel="Submit an inquiry"
    actionHref="/contact"
    secondaryLabel="Review compliance"
    secondaryHref="/certifications"
  />
</SiteLayout>

<style>
  .two {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }
  .prose { display: grid; gap: var(--space-5); max-width: 68ch }
  .prose p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-body);
    text-wrap: pretty;
  }
  .prose--dark p { color: var(--text-on-dark-body) }
  .aside { display: grid; gap: var(--space-8) }
  .aside--wide { max-width: var(--container-text); margin-top: var(--space-12) }
  .grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gutter-lg);
    margin-top: var(--space-12);
  }
  .more { margin-top: var(--space-12) }

  @media (max-width: 1100px) {
    .two { grid-template-columns: 1fr; gap: var(--space-10) }
    .grid-4 { grid-template-columns: repeat(2, 1fr) }
  }
  @media (max-width: 620px) { .grid-4 { grid-template-columns: 1fr } }
</style>
