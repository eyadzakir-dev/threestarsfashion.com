---
/**
 * Contact. Maps to InquiryScreen.jsx, with one deliberate difference: the Tally
 * embed stays. The design system adds first-party field components, but this is a
 * static site with no backend, and Tally already receives submissions. Building a
 * first-party form would mean either a new vendor or an undocumented endpoint.
 *
 * Both third-party embeds are preserved exactly: the Tally form and the Google
 * Maps iframe, including its coordinates and place ID (PARITY.md §3.8).
 *
 * The legacy page was MISSING the opening <meta name="description"> tag, which
 * force-closed <head> and pushed every og/twitter/stylesheet tag into <body>.
 * The description text is preserved verbatim in a well-formed tag. PARITY.md §4.
 *
 * Phone numbers are NOT normalised — PARITY.md §7 leaves the three formats OPEN.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Band from '../components/ds/Band.astro';
import PageHead from '../components/ds/PageHead.astro';
import SectionHeading from '../components/ds/SectionHeading.astro';
import SpecTable from '../components/ds/SpecTable.astro';
import { COMPANY } from '../data/site';

const TALLY_SRC = 'https://tally.so/embed/9qvgVp?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1';
const MAP_SRC = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3444.0!2d29.7788598!3d31.0302978!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14f5932fe7f32ec9%3A0x86e2c0b341a01c68!2sThree+Stars+Fashion!5e0!3m2!1sen!2seg!4v1700000000000!5m2!1sen!2seg';

const RECORDS = [
  { label: 'Factory / head office', value: COMPANY.street },
  { label: 'City', value: `${COMPANY.city}, ${COMPANY.country}` },
  { label: 'Postal code', value: COMPANY.postalCode },
] as const;
---

<SiteLayout
  title="Contact Us | Three Stars Fashion - Submit an Inquiry for Garment Manufacturing"
  description="Contact Three Stars Fashion Group for garment manufacturing inquiries and submit an inquiry. Visit our Alexandria Free Zone facilities or reach us via phone (+2 03 4500550) and email (info@tsf.com.eg)."
  canonical="https://threestarsfashion.com/contact"
  ogTitle="Contact Three Stars Fashion | Submit an Inquiry"
  ogDescription="Get in touch with Three Stars Fashion for garment manufacturing. Submit an inquiry today. Alexandria Free Zone, Egypt. Tel: +2 03 4500550."
  ogUrl="https://threestarsfashion.com/contact"
  twitterTitle="Contact Three Stars Fashion | Submit an Inquiry"
  twitterDescription="Get in touch with Three Stars Fashion for garment manufacturing. Submit an inquiry today. Alexandria Free Zone, Egypt. Tel: +2 03 4500550."
  activeNav="/contact"
>
  <PageHead
    eyebrow="Contact"
    lead="Send volumes and dates,"
    title="get a capacity answer"
    standfirst="Whether you're sourcing a new manufacturing partner for ongoing programs, evaluating capacity for a new product line, or requesting compliance documentation, our team is ready to support your requirements."
  />

  <Band surface="page">
    <div class="two">
      <div class="form">
        <SectionHeading size="display-3" eyebrow="Inquiry" title="Submit an inquiry" />
        <iframe
          data-tally-src={TALLY_SRC}
          loading="lazy"
          width="100%"
          height="600"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          title="Submit an Inquiry / Contact Form"
        ></iframe>
      </div>

      <div class="records">
        <div class="record">
          <p class="record__label">Factory / head office</p>
          <address class="record__value">
            {COMPANY.street}<br />
            {COMPANY.city}, {COMPANY.country}<br />
            Postal Code: {COMPANY.postalCode}
          </address>
        </div>
        <div class="record">
          <p class="record__label">Phone</p>
          <p class="record__value">
            <a href={COMPANY.phoneLandlineHref}>{COMPANY.phoneLandline}</a><br />
            <a href={COMPANY.phoneMobileHref}>{COMPANY.phoneMobile}</a>
          </p>
        </div>
        <div class="record">
          <p class="record__label">Email</p>
          <p class="record__value"><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></p>
        </div>
        <div class="record">
          <p class="record__label">LinkedIn</p>
          <p class="record__value">
            <a href={COMPANY.linkedin} target="_blank" rel="noopener noreferrer">Three Stars Fashion</a>
          </p>
        </div>
      </div>
    </div>
  </Band>

  <Band surface="sunken" tight>
    <SectionHeading
      size="display-3"
      eyebrow="Location"
      lead="Alexandria"
      title="Public Free Zone"
      standfirst="Direct access to Alexandria's commercial port. Audits welcome, unannounced or scheduled."
    />
    <div class="map">
      <iframe
        src={MAP_SRC}
        width="100%"
        height="450"
        style="border:0; display:block;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Three Stars Fashion - Alexandria Free Zone, Egypt"
      ></iframe>
    </div>
    <div class="table">
      <SpecTable caption="Address" numericValues={false} rows={RECORDS} />
    </div>
  </Band>

  <Fragment slot="tail">
    <!-- Tally loader, preserved verbatim from legacy/contact.html. It must run
         before Tally's own embed.js resolves data-tally-src into src. -->
    <script is:inline>
      var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}
    </script>
  </Fragment>
</SiteLayout>

<style>
  .two {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }
  .form { display: grid; gap: var(--space-8) }
  .form iframe { border: var(--border-hair) solid var(--rule-hair) }

  .records { display: grid; gap: var(--space-8) }
  .record { padding-top: var(--space-4); border-top: var(--border-mid) solid var(--rule-strong) }
  .record__label {
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }
  .record__value {
    font-style: normal;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-display);
  }
  .record__value a { color: var(--text-display); text-decoration: none }
  .record__value a:hover { color: var(--text-accent); text-decoration: underline; text-underline-offset: 3px }

  .map {
    margin-top: var(--space-12);
    border: var(--border-hair) solid var(--rule-hair);
  }
  .table { margin-top: var(--space-10); max-width: var(--container-text) }

  @media (max-width: 1100px) {
    .two { grid-template-columns: 1fr; gap: var(--space-12) }
  }
</style>
