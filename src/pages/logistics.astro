---
/**
 * Logistics. No design reference existed for this page; composed from primitives.
 *
 * Every Green Point Logistics claim is preserved from legacy/logistics.html,
 * including the four capability cards and the three GPL stats.
 *
 * TWO THINGS DELIBERATELY LEFT ALONE:
 *  - "15+ Years Experience" is OPEN in PARITY.md conflict 2. Against foundingDate
 *    2008 and the site's own © 2026 that reads as 18 years, and the figure sits
 *    unlabelled in the GPL stat row so it may be scoped to GPL rather than the
 *    group. Carried across verbatim rather than silently recalculated.
 *  - "98% on-time delivery" is META-ONLY (PARITY.md conflict 4): it appears in
 *    three meta tags on the legacy page and in no body copy anywhere. It stays
 *    in the meta, unpromoted — surfacing it into body copy would make a
 *    newly prominent claim out of something never stated to a reader.
 *
 * The GPL green tokens exist for this sub-brand only and are never used for TSG UI.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import MediaSlot from '../components/MediaSlot.astro';
import Band from '../components/ds/Band.astro';
import PageHead from '../components/ds/PageHead.astro';
import SectionHeading from '../components/ds/SectionHeading.astro';
import SpecTable from '../components/ds/SpecTable.astro';
import StatBlock from '../components/ds/StatBlock.astro';
import ValueCard from '../components/ds/ValueCard.astro';
import Button from '../components/ds/Button.astro';
import CalloutBand from '../components/ds/CalloutBand.astro';
import { TRADE, TRANSIT, COMPANY } from '../data/site';

const GPL_STATS = [
  { value: '40', suffix: '+', label: 'Countries served' },
  { value: '3', label: 'Shipping modes (air, sea, land)' },
  { value: '15', suffix: '+', label: 'Years experience' },
] as const;

const CAPABILITIES = [
  {
    label: 'Global freight',
    title: 'Air, sea and land',
    body: 'Air, sea, and land transportation with optimized routes across continents for maximum efficiency.',
  },
  {
    label: 'Customs',
    title: 'Egyptian customs expertise',
    body: 'Specialized Egyptian customs expertise ensuring smooth, compliant shipments with minimal delays.',
  },
  {
    label: 'Warehousing',
    title: 'Raw material and finished goods',
    body: 'Dedicated warehousing for raw materials and finished goods, with specialized storage solutions available on request.',
  },
  {
    label: 'Specialized shipping',
    title: 'GOH, flat-pack and custom',
    body: 'Flexible shipping configurations including garment-on-hanger (GOH), flat-pack, and custom packing to meet retailer requirements.',
  },
] as const;

const PROCESS = [
  { label: 'Precision manufacturing', value: 'High-volume production across our multi-building facility complex with 3,100+ sewing machines and trained production operators.' },
  { label: 'Rigorous quality control', value: 'Multi-stage inspection processes ensuring every garment meets international quality standards.' },
  { label: 'Priority global delivery', value: 'Fast-tracked logistics with real-time tracking and optimized shipping routes worldwide.' },
] as const;
---

<SiteLayout
  title="Logistics | Three Stars Fashion - Duty-Free Garment Export from Egypt to USA & Europe"
  description="Three Stars Fashion and Green Point Logistics offer integrated supply chain solutions. Duty-free garment export from Egypt to USA (QIZ) and Europe (Euro 1). Less than 1 week freight to Europe, 3 weeks to USA. 98% on-time delivery."
  canonical="https://threestarsfashion.com/logistics"
  ogTitle="Logistics | Three Stars Fashion & Green Point"
  ogDescription="Integrated garment supply chain. Duty-free export from Egypt to USA (QIZ) & Europe (Euro 1). Under 1 week to Europe, 3 weeks to USA. 98% on-time."
  ogUrl="https://threestarsfashion.com/logistics"
  twitterTitle="Logistics | Three Stars Fashion & Green Point"
  twitterDescription="Integrated garment supply chain. Duty-free export from Egypt to USA (QIZ) & Europe (Euro 1). Under 1 week to Europe, 3 weeks to USA. 98% on-time."
  activeNav="/logistics"
>
  <PageHead
    eyebrow="Vertical integration"
    lead="From production floor"
    title="to destination port"
    standfirst="Fully integrated manufacturing and logistics operations that eliminate handoff risk, protect lead times, and simplify vendor management."
  />

  <Band surface="page">
    <div class="two">
      <div class="prose">
        <SectionHeading
          size="display-3"
          eyebrow="Our logistics arm"
          lead="Green Point Logistics,"
          title="in-house supply chain"
        />
        <p>
          Green Point Logistics (GPL) is the dedicated logistics subsidiary of Three
          Stars Fashion Group, providing fully integrated supply chain management from
          production floor to destination port. As an in-house operation, GPL eliminates
          the gaps between manufacturing and delivery — giving our partners a single
          point of accountability across the entire fulfillment cycle.
        </p>
        <p>
          From order consolidation and export documentation through freight forwarding
          and final-mile coordination, every touchpoint is managed internally — ensuring
          consistency, visibility, and on-time delivery.
        </p>
        <div class="gpl-logo">
          <MediaSlot
            dir="assets/Greenpoint"
            basename="logo"
            alt="Green Point Logistics"
            aspectRatio="3 / 1"
            fit="contain"
            posterOnly
          />
        </div>
      </div>
      <div class="aside">
        {GPL_STATS.map((s) => (
          <StatBlock size="lg" value={s.value} suffix={s.suffix} label={s.label} />
        ))}
      </div>
    </div>
  </Band>

  <Band surface="sunken">
    <SectionHeading
      size="display-3"
      eyebrow="Capabilities"
      lead="Four functions,"
      title="one accountable party"
    />
    <div class="grid-4">
      {CAPABILITIES.map((c) => <ValueCard label={c.label} title={c.title} body={c.body} />)}
    </div>
  </Band>

  <Band surface="navy" grid>
    <div class="two">
      <SectionHeading
        size="display-3"
        eyebrow="Transit"
        lead="Alexandria to"
        title="the US East Coast"
        standfirst="Freight to most European countries typically arrives within one week, while shipments to major U.S. ports average approximately three weeks. Egypt has duty-free access to the United States under the Qualifying Industrial Zones (QIZ) agreement, and to Europe under the Euro-Mediterranean Partnership (Euro 1) agreement."
        onDark
      />
      <div class="aside">
        <SpecTable caption="Trade access" numericValues={false} rows={TRADE} onDark />
      </div>
    </div>

    <ol class="transit">
      {TRANSIT.map((t) => (
        <li class="transit__step">
          <div class="transit__marker" aria-hidden="true"></div>
          <p class="transit__stage">{t.stage}</p>
          <p class="transit__detail">{t.detail}</p>
          {t.days && (
            <p class="transit__days">
              <span class="transit__num">{t.days}</span><span class="transit__unit">days</span>
            </p>
          )}
        </li>
      ))}
    </ol>

    <MediaSlot slotName="logistics" alt="" aspectRatio="21 / 9" quiet />
  </Band>

  <Band surface="page">
    <div class="two">
      <SectionHeading
        size="display-3"
        eyebrow="The 1-2-3 process"
        lead="Manufacture,"
        title="inspect, deliver"
      />
      <div class="aside">
        <SpecTable caption="Process" numericValues={false} rows={PROCESS} />
      </div>
    </div>
    <div class="more">
      <Button href={COMPANY.gpl} variant="secondary" external arrow>Visit Green Point Logistics</Button>
    </div>
  </Band>

  <CalloutBand
    eyebrow="Next step"
    title="Need a landed cost and a date?"
    body="Send destination port, volumes and target ex-factory dates. Freight is quoted in-house, not brokered."
    actionLabel="Submit an inquiry"
    actionHref="/contact"
    secondaryLabel="Read the FAQ"
    secondaryHref="/faq"
  />
</SiteLayout>

<style>
  .two {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }
  .prose { display: grid; gap: var(--space-5); max-width: 68ch }
  .prose p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-body);
    text-wrap: pretty;
  }
  .gpl-logo { max-width: 220px; margin-top: var(--space-4) }
  .aside { display: grid; gap: var(--space-8) }
  .grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gutter-lg);
    margin-top: var(--space-12);
  }
  .more { margin-top: var(--space-12) }

  .transit {
    list-style: none;
    margin: 0 0 var(--space-12);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--gutter);
    border-top: var(--border-hair) solid var(--rule-on-dark);
  }
  .transit__step { position: relative; padding-top: var(--space-6) }
  .transit__marker {
    position: absolute;
    top: -1px;
    left: 0;
    width: var(--space-8);
    height: var(--border-mid);
    background: var(--rule-accent);
  }
  .transit__stage {
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-on-dark);
    margin-bottom: var(--space-2);
  }
  .transit__detail {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--text-on-dark-body);
  }
  .transit__days { display: flex; align-items: baseline; gap: 0.15em; margin-top: var(--space-3) }
  .transit__num {
    font-family: var(--font-numeral);
    font-size: var(--fs-numeral-md);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-numeral);
    line-height: var(--lh-numeral);
    font-variant-numeric: var(--numeric-tabular);
    color: var(--text-on-dark);
  }
  .transit__unit {
    font-size: var(--fs-caption);
    font-weight: var(--weight-semibold);
    color: var(--text-accent);
  }

  @media (max-width: 1100px) {
    .two { grid-template-columns: 1fr; gap: var(--space-10) }
    .grid-4 { grid-template-columns: repeat(2, 1fr) }
    .transit { grid-template-columns: repeat(2, 1fr); gap: var(--space-8) }
  }
  @media (max-width: 620px) {
    .grid-4 { grid-template-columns: 1fr }
    .transit { grid-template-columns: 1fr }
  }
</style>
