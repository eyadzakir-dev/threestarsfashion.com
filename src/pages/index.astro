---
/**
 * Homepage — a single-scroll narrative in seven sections, matching
 * ui_kits/website/HomeScreen.jsx from the design system.
 *
 * Every section ends with a link to its sub-page. Type carries the page: large
 * numerals are a first-class element, not body text.
 *
 * Head tags are ported verbatim from the legacy index.html, including the
 * Organization JSON-LD. Copy is rewritten (CLAUDE.md permits that); claims are
 * not — every figure comes from src/data/site.ts, whose authority is PARITY.md.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import MediaSlot from '../components/MediaSlot.astro';
import ProcessScroll from '../components/ProcessScroll.astro';
import Band from '../components/ds/Band.astro';
import Eyebrow from '../components/ds/Eyebrow.astro';
import Button from '../components/ds/Button.astro';
import SectionHeading from '../components/ds/SectionHeading.astro';
import StatBlock from '../components/ds/StatBlock.astro';
import SpecTable from '../components/ds/SpecTable.astro';
import CapabilityCard from '../components/ds/CapabilityCard.astro';
import CertificationBadge from '../components/ds/CertificationBadge.astro';
import LogoWall from '../components/ds/LogoWall.astro';
import CalloutBand from '../components/ds/CalloutBand.astro';

import {
  STATS, CAPABILITIES, PROGRAMME, GROUP_COMPANIES, TRADE,
  CERTIFICATIONS, APPROVALS, BRANDS, TRANSIT,
} from '../data/site';

const ORGANIZATION_JSONLD = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Three Stars Fashion Group',
  alternateName: 'TSF',
  url: 'https://threestarsfashion.com',
  logo: 'https://threestarsfashion.com/assets/Brands/tsflogo.png',
  image: 'https://threestarsfashion.com/assets/og-image.jpg',
  description:
    'A leading garment manufacturing and apparel exporting group based in Alexandria, Egypt, specializing in high-quality knitted and woven garments for globally recognized brands and retailers.',
  foundingDate: '2008',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Street No. 7, Public Free Zone Amreya',
    addressLocality: 'Alexandria',
    addressCountry: 'EG',
    postalCode: '23512',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+20-3-4500550',
    contactType: 'sales',
    email: 'info@tsf.com.eg',
    availableLanguage: ['English', 'Arabic'],
  },
  sameAs: ['https://www.linkedin.com/company/three-stars-fashion-group/'],
  knowsAbout: [
    'Garment Manufacturing', 'Apparel Export', 'Knitted Garments', 'Woven Garments',
    'Activewear', 'Casualwear', 'Screen Printing', 'Embroidery',
    'Private Label Manufacturing', 'OEM Apparel',
  ],
  hasCredential: [
    'ISO 9001', 'WRAP Gold', 'OEKO-TEX Standard 100', 'GRS - Global Recycled Standard',
    'BSCI', 'SEDEX', 'Better Work', 'Higg Index', 'OCS - Organic Content Standard',
  ].map((name) => ({ '@type': 'EducationalOccupationalCredential', name })),
};
---

<SiteLayout
  title="Three Stars Fashion | Garment Manufacturer in Egypt | OEM Apparel Exporter"
  description="Three Stars Fashion Group (TSF) is a leading garment manufacturer and apparel exporter based in Egypt. Specializing in knitted and woven garments with 85,000+ daily unit capacity, serving Nike, Puma, Calvin Klein, Zara, and more. ISO 9001, WRAP Gold certified. Duty-free export to USA and Europe."
  canonical="https://threestarsfashion.com/"
  ogTitle="Three Stars Fashion | Garment Manufacturer, Egypt"
  ogDescription="Leading garment manufacturer in Egypt. 85,000+ daily units, 10 factories, ISO 9001 & WRAP Gold certified. Duty-free export to USA & Europe."
  ogUrl="https://threestarsfashion.com/"
  twitterTitle="Three Stars Fashion | Garment Manufacturer, Egypt"
  twitterDescription="Leading garment manufacturer in Egypt. 85,000+ daily units, 10 factories, ISO 9001 & WRAP Gold certified. Duty-free export to USA & Europe."
  activeNav={null}
  headerOverlay
>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify(ORGANIZATION_JSONLD)}
  />

  <!-- 1. Hero -->
  <section class="hero">
    <div class="hero__media">
      <MediaSlot slotName="hero" alt="" aspectRatio="16 / 9" eager />
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__inner">
      <div class="hero__copy">
        <Eyebrow tone="slate">Established 2008 &middot; Alexandria Free Zone, Egypt</Eyebrow>
        <h1 class="hero__title">
          <span class="hero__lead">Ten factories.</span>
          <span class="hero__subject">One production line of record.</span>
        </h1>
        <p class="hero__standfirst">
          Three Stars Fashion Group is a vertically integrated garment manufacturer
          in Alexandria, Egypt &mdash; 85,000 units a working day, certified
          facilities, in-house logistics, and duty-free access to the United States
          and the European Union.
        </p>
        <Button href="/contact" arrow>Submit an inquiry</Button>
      </div>
      <div class="hero__figure">
        <StatBlock
          size="hero"
          value="85,000"
          suffix="+"
          label="Units per working day"
          footnote="Across ten factories, single shift. 24/7 capability on request."
          onDark
          animate
        />
      </div>
    </div>
  </section>

  <!-- 2. Scale -->
  <Band surface="page" tight id="scale">
    <div class="scale">
      {STATS.map((s) => (
        <StatBlock
          size="lg"
          value={s.value}
          suffix={s.suffix}
          label={s.label}
          animate={s.animate}
        />
      ))}
    </div>
    <div class="section-more">
      <Button href="/about" variant="ghost" arrow>How the group is structured</Button>
    </div>
  </Band>

  <!-- 3. Process -->
  <ProcessScroll />

  <Band surface="sunken" tight>
    <div class="split">
      <SectionHeading
        size="display-3"
        eyebrow="Capability"
        lead="End-to-end"
        title="manufacturing under one roof"
        standfirst="Development, cutting, sewing, embellishment, finishing and export — inside a single complex in the Alexandria Public Free Zone."
      />
      <div class="split__aside">
        <SpecTable caption="Programme parameters" rows={PROGRAMME} />
      </div>
    </div>
    <div class="cards cards--4">
      {CAPABILITIES.map((c) => (
        <CapabilityCard
          index={c.index}
          title={c.title}
          description={c.description}
          meta={c.meta}
          dir={c.dir}
          basename={c.basename}
          alt={c.alt}
          href="/services"
        />
      ))}
    </div>
    <div class="section-more">
      <Button href="/services" variant="secondary" arrow>All seven services</Button>
    </div>
  </Band>

  <!-- 4. Facilities -->
  <Band surface="page">
    <div class="split">
      <SectionHeading
        size="display-3"
        eyebrow="Facilities"
        lead="Three buildings,"
        title="one complex, open to audit"
        standfirst="Sourcing teams are welcome to audit any building, unannounced or scheduled. The complex sits inside the Alexandria Public Free Zone with direct access to the commercial port."
      />
      <div class="split__aside">
        <SpecTable caption="Group companies" numericValues={false} rows={GROUP_COMPANIES} />
      </div>
    </div>
    <!--
      The facilities slot is deliberately empty, awaiting real footage. It renders
      the engineering grid field rather than generated facility imagery: visitors
      physically audit these buildings under WRAP, BSCI, Sedex and Better Work,
      so fabricated facility imagery is a compliance risk, not a design choice.
    -->
    <MediaSlot slotName="facilities" alt="" aspectRatio="21 / 9" />
    <div class="section-more">
      <Button href="/facilities" variant="secondary" arrow>Tour the facilities</Button>
    </div>
  </Band>

  <!-- 5. Compliance -->
  <Band surface="sunken">
    <div class="split">
      <SectionHeading
        size="display-3"
        eyebrow="Compliance"
        lead="Audited,"
        title="documented, current"
        standfirst="Certificates are issued to the facility, not the group — every document names the building it covers. Documentation is available to partners on request."
      />
      <div class="split__aside">
        <p class="approvals__label">Approved by</p>
        <p class="approvals__list">{APPROVALS.join(' · ')}</p>
      </div>
    </div>
    <div class="cards cards--3">
      {CERTIFICATIONS.slice(0, 6).map((c) => (
        <CertificationBadge name={c.name} grade={c.grade} scope={c.scope} />
      ))}
    </div>
    <div class="section-more">
      <Button href="/certifications" variant="secondary" arrow>
        All eleven certifications and approvals
      </Button>
    </div>
  </Band>

  <!-- 6. Logistics -->
  <Band surface="navy" grid>
    <div class="split">
      <SectionHeading
        size="display-3"
        eyebrow="Logistics"
        lead="Alexandria to"
        title="the US East Coast"
        standfirst="Green Point Logistics is the group's in-house freight, customs and warehousing arm, so there is no third-party handoff between the production floor and the destination port."
        onDark
      />
      <div class="split__aside">
        <SpecTable caption="Trade access" numericValues={false} rows={TRADE} onDark />
      </div>
    </div>

    <ol class="transit">
      {TRANSIT.map((t) => (
        <li class="transit__step">
          <div class="transit__marker" aria-hidden="true"></div>
          <p class="transit__stage">{t.stage}</p>
          <p class="transit__detail">{t.detail}</p>
          {t.days && (
            <p class="transit__days">
              <span class="transit__num">{t.days}</span><span class="transit__unit">days</span>
            </p>
          )}
        </li>
      ))}
    </ol>

    <MediaSlot slotName="logistics" alt="" aspectRatio="21 / 9" quiet />
    <div class="section-more">
      <Button href="/logistics" variant="onDark" arrow>How shipping works</Button>
    </div>
  </Band>

  <!-- 7. Clients and contact -->
  <Band surface="page">
    <SectionHeading
      align="center"
      eyebrow="Approved supplier"
      lead="Manufacturing for"
      title="brands that audit before they buy"
    />
    <div class="logos">
      <LogoWall logos={BRANDS} columns={6} />
    </div>
    <div class="section-more section-more--center">
      <Button href="/contact" variant="secondary" arrow>Submit an inquiry</Button>
    </div>
  </Band>

  <CalloutBand
    eyebrow="Next step"
    title="Ready to discuss your next production programme?"
    body="Send volumes, categories and target ex-factory dates. You will get a capacity answer and a compliance pack, not a brochure."
    actionLabel="Submit an inquiry"
    actionHref="/contact"
    secondaryLabel="Book a factory audit"
    secondaryHref="/facilities"
  />
</SiteLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 92vh;
    display: grid;
    align-items: end;
    background: var(--surface-void);
    border-bottom: var(--keyline-accent);
    overflow: hidden;
  }
  .hero__media { position: absolute; inset: 0 }
  .hero__media :global(.media-slot) { width: 100%; height: 100%; aspect-ratio: auto }

  /* Protection gradient — the only permitted gradient, and only where text
     sits over photography. */
  .hero__scrim { position: absolute; inset: 0; background: var(--protect-full) }

  .hero__inner {
    position: relative;
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: calc(var(--header-h) + var(--space-24)) var(--page-pad) var(--space-20);
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: var(--space-16);
    align-items: end;
  }
  .hero__copy { display: grid; gap: var(--space-6); justify-items: start }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--fs-display-1);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    color: var(--text-on-dark);
    max-width: 20ch;
    display: grid;
  }
  .hero__lead { font-weight: var(--weight-light) }
  .hero__subject { font-weight: var(--weight-semibold) }

  .hero__standfirst {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body);
    color: var(--text-on-dark-body);
    max-width: 56ch;
    text-wrap: pretty;
  }

  /* ── Scale ────────────────────────────────────────────────────── */
  .scale { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gutter-lg) }

  /* ── Shared section furniture ─────────────────────────────────── */
  .split {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-16);
    align-items: start;
    margin-bottom: var(--space-16);
  }
  .split__aside { display: grid; gap: var(--space-6) }

  .cards { display: grid; gap: var(--gutter) }
  .cards--4 { grid-template-columns: repeat(4, 1fr) }
  .cards--3 { grid-template-columns: repeat(3, 1fr) }

  .section-more { margin-top: var(--space-12) }
  .section-more--center { display: grid; justify-items: center }

  .logos { margin-top: var(--space-12) }

  .approvals__label {
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-3);
    padding-top: var(--space-4);
    border-top: var(--border-mid) solid var(--rule-strong);
  }
  .approvals__list {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-display);
    font-weight: var(--weight-medium);
  }

  /* ── Transit timeline ─────────────────────────────────────────── */
  .transit {
    list-style: none;
    margin: 0 0 var(--space-12);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--gutter);
    border-top: var(--border-hair) solid var(--rule-on-dark);
  }
  .transit__step { position: relative; padding-top: var(--space-6) }
  .transit__marker {
    position: absolute;
    top: -1px;
    left: 0;
    width: var(--space-8);
    height: var(--border-mid);
    background: var(--rule-accent);
  }
  .transit__stage {
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-on-dark);
    margin-bottom: var(--space-2);
  }
  .transit__detail {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--text-on-dark-body);
  }
  .transit__days { display: flex; align-items: baseline; gap: 0.15em; margin-top: var(--space-3) }
  .transit__num {
    font-family: var(--font-numeral);
    font-size: var(--fs-numeral-md);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-numeral);
    line-height: var(--lh-numeral);
    font-variant-numeric: var(--numeric-tabular);
    color: var(--text-on-dark);
  }
  .transit__unit {
    font-size: var(--fs-caption);
    font-weight: var(--weight-semibold);
    color: var(--text-accent);
  }

  /* ── Responsive ───────────────────────────────────────────────── */
  @media (max-width: 1100px) {
    .hero__inner { grid-template-columns: 1fr; gap: var(--space-12) }
    .split { grid-template-columns: 1fr; gap: var(--space-10) }
    .cards--4 { grid-template-columns: repeat(2, 1fr) }
    .cards--3 { grid-template-columns: repeat(2, 1fr) }
    .transit { grid-template-columns: repeat(2, 1fr); gap: var(--space-8) }
  }
  @media (max-width: 760px) {
    .scale { grid-template-columns: repeat(2, 1fr); gap: var(--space-8) }
    .cards--4, .cards--3 { grid-template-columns: 1fr }
    .transit { grid-template-columns: 1fr }
    .hero { min-height: auto }
    .hero__inner { padding-block: calc(var(--header-h) + var(--space-16)) var(--space-16) }
  }
</style>

<script>
  import { initCounters } from '../scripts/counters';
  initCounters();
</script>
