---
/**
 * Privacy policy. No design reference; composed from primitives.
 *
 * All eight numbered sections and every claim are preserved verbatim from
 * legacy/privacy-policy.html, including the Tally.so processor disclosure and the
 * three named affiliates (note: three here, versus four entities on the about
 * page, which includes TSF itself — PARITY.md §3.9 records the difference).
 *
 * The legacy page was MISSING the opening <meta name="description"> tag, which
 * force-closed <head>. The description text is preserved verbatim in a
 * well-formed tag. PARITY.md §4.
 *
 * The legacy page carried 34 inline style attributes; all of it is tokens now.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Band from '../components/ds/Band.astro';
import PageHead from '../components/ds/PageHead.astro';
import { COMPANY } from '../data/site';
---

<SiteLayout
  title="Privacy Policy | Three Stars Fashion Group"
  description="Privacy Policy for Three Stars Fashion Group. Learn how we collect, use, and protect your personal information when you contact us or submit an inquiry for garment manufacturing services."
  canonical="https://threestarsfashion.com/privacy-policy"
  ogTitle="Privacy Policy | Three Stars Fashion Group"
  ogDescription="Privacy policy for Three Stars Fashion Group. How we collect, use, and protect your information when you contact us or submit an inquiry."
  ogUrl="https://threestarsfashion.com/privacy-policy"
  twitterTitle="Privacy Policy | Three Stars Fashion Group"
  twitterDescription="Privacy policy for Three Stars Fashion Group. How we collect, use, and protect your information when you contact us or submit an inquiry."
  activeNav={null}
>
  <PageHead
    eyebrow="Last Updated: April 2026"
    title="Privacy Policy"
    standfirst='Three Stars Fashion Group ("TSF", "we", "us", or "our") operates threestarsfashion.com. This policy explains what we collect, why, and what we do not do.'
  />

  <Band surface="page">
    <div class="legal">
      <section>
        <h2>1. Information We Collect</h2>
        <p>When you contact us or submit an inquiry, we may collect:</p>
        <ul>
          <li><strong>Contact Details:</strong> Your name, company name, email address, and phone number.</li>
          <li><strong>Inquiry Details:</strong> Your message, project requirements, and any other information you voluntarily provide.</li>
          <li><strong>Technical Data:</strong> Standard website log data including your IP address, browser type, and pages visited.</li>
        </ul>
        <p>We do not collect any sensitive personal data (such as payment card information) through this website.</p>
      </section>

      <section>
        <h2>2. How We Use Your Information</h2>
        <p>We use the information you provide to:</p>
        <ul>
          <li>Respond to your manufacturing or logistics inquiry.</li>
          <li>Provide quotations, capacity answers and compliance documentation.</li>
          <li>Maintain a record of our correspondence with you.</li>
        </ul>
        <p>We will not use your information for unsolicited marketing without your prior consent.</p>
      </section>

      <section>
        <h2>3. Data Sharing</h2>
        <p>We do not sell, rent, or trade your personal information to third parties. Your information may be shared only as follows:</p>
        <ul>
          <li><strong>Group Companies:</strong> Your information may be shared with our affiliate companies (Three Stars Apparels, Golden Stars Textile, Green Point Logistics) as necessary to fulfill your manufacturing or logistics inquiries.</li>
          <li><strong>Service Providers:</strong> We use Tally.so to process contact form submissions. Their privacy policy governs how they handle your data.</li>
        </ul>
      </section>

      <section>
        <h2>4. Cookies &amp; Analytics</h2>
        <p>We do not use cookies to track you across other websites.</p>
      </section>

      <section>
        <h2>5. Data Retention &amp; Security</h2>
        <p>We retain inquiry correspondence for as long as necessary to serve the business relationship, and apply appropriate measures to protect it against unauthorised access, alteration or disclosure.</p>
      </section>

      <section>
        <h2>6. Your Rights</h2>
        <p>You may request to:</p>
        <ul>
          <li>Access the personal information we hold about you.</li>
          <li>Correct inaccurate information.</li>
          <li>Request deletion of your information.</li>
          <li>Object to or restrict our processing of your information.</li>
        </ul>
      </section>

      <section>
        <h2>7. Changes to This Policy</h2>
        <p>We may update this policy from time to time. The "Last Updated" date above reflects the most recent revision.</p>
      </section>

      <section>
        <h2>8. Contact Us</h2>
        <p>For any question about this policy or your information:</p>
        <address>
          Three Stars Fashion Group<br />
          {COMPANY.street}, {COMPANY.city}, {COMPANY.country} {COMPANY.postalCode}<br />
          Email: <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a><br />
          Tel: <a href={COMPANY.phoneLandlineHref}>{COMPANY.phoneLandline}</a>
        </address>
      </section>
    </div>
  </Band>
</SiteLayout>

<style>
  .legal {
    max-width: var(--container-text);
    display: grid;
    gap: var(--space-12);
  }
  .legal section { display: grid; gap: var(--space-4) }
  .legal h2 {
    font-family: var(--font-display);
    font-size: var(--fs-heading-1);
    font-weight: var(--weight-semibold);
    color: var(--text-display);
    padding-top: var(--space-4);
    border-top: var(--border-mid) solid var(--rule-strong);
  }
  .legal p,
  .legal li,
  .legal address {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-body);
    font-style: normal;
    text-wrap: pretty;
  }
  .legal ul { margin: 0; padding-left: var(--space-6); display: grid; gap: var(--space-2) }
  .legal strong { color: var(--text-display); font-weight: var(--weight-semibold) }
</style>
