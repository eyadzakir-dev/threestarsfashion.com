---
/**
 * Facilities. Maps to FacilitiesScreen.jsx.
 *
 * All three named buildings, the four department galleries and the trade-access
 * claim are preserved from legacy/facilities.html.
 *
 * CONTENT RESOLUTION, PARITY.md §6: the printing facility description carries no
 * pieces-per-day figure. The meta description is also rewritten — its "automated
 * Gerber cutting systems" was META-ONLY (PARITY.md conflict 4), appearing in no
 * body copy anywhere on the site. Gerber is retained in the meta as the legacy
 * page had it, since dropping it would silently delete the only machinery-brand
 * claim the site makes.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import MediaSlot from '../components/MediaSlot.astro';
import Band from '../components/ds/Band.astro';
import PageHead from '../components/ds/PageHead.astro';
import SectionHeading from '../components/ds/SectionHeading.astro';
import SpecTable from '../components/ds/SpecTable.astro';
import CapabilityCard from '../components/ds/CapabilityCard.astro';
import Gallery from '../components/ds/Gallery.astro';
import Button from '../components/ds/Button.astro';
import CalloutBand from '../components/ds/CalloutBand.astro';
import { TRADE } from '../data/site';

const BUILDINGS = [
  {
    index: '01',
    title: 'Three Stars Printing Facility',
    description: 'Our dedicated printing facility houses six advanced screen printing machines, delivering vibrant, durable prints.',
    meta: 'Six screen printing machines',
    dir: 'assets/Buildings',
    basename: 'Printing Facility',
    alt: 'Three Stars printing facility exterior',
  },
  {
    index: '02',
    title: 'Administrative Building',
    description: 'The nerve center of our operations, housing administrative and technical offices, our precision cutting department, and extensive fabric storage facilities.',
    meta: 'Cutting + fabric store',
    // NB: the filename is misspelled "Adminstrative" in the repo and is
    // referenced as-is. Renaming it would break the legacy pages too.
    dir: 'assets/Buildings',
    basename: 'Adminstrative Building',
    alt: 'Administrative building exterior',
  },
  {
    index: '03',
    title: 'TSF Building (B) — Production Hub',
    description: 'Our primary production building encompasses the sewing department, packing area, accessories store, and finished goods warehouse for seamless operations.',
    meta: 'Primary production hub',
    dir: 'assets/Buildings',
    basename: 'TSF Building (B)',
    alt: 'TSF Building B exterior',
  },
] as const;

const CUTTING = [
  { dir: 'assets/Cutting Area', basename: '1 (1)', alt: 'Cutting area' },
  { dir: 'assets/Cutting Area', basename: '2', alt: 'Spreading table' },
  { dir: 'assets/Cutting Area', basename: '3', alt: 'CAD-driven cutting' },
  { dir: 'assets/Cutting Area', basename: '4', alt: 'Ply stacking' },
  { dir: 'assets/Cutting Area', basename: '5', alt: 'Marker layout' },
  { dir: 'assets/Cutting Area', basename: '7', alt: 'Cut panel bundling' },
  { dir: 'assets/Cutting Area', basename: '8', alt: 'Cutting department floor' },
  { dir: 'assets/Cutting Area', basename: '9', alt: 'Automated cutting machine' },
] as const;

const PRINTING = [
  { dir: 'assets/Printing Facility', basename: '4', alt: 'Screen printing line' },
  { dir: 'assets/Printing Facility', basename: '5', alt: 'Print carousel' },
  { dir: 'assets/Printing Facility', basename: '6', alt: 'Print curing' },
] as const;

const PRODUCTION = [
  { dir: 'assets/Production', basename: '1', alt: 'Sewing line' },
  { dir: 'assets/Production', basename: '2', alt: 'Flat-seam operators' },
  { dir: 'assets/Production', basename: '3', alt: 'Assembly line' },
  { dir: 'assets/Production', basename: '5', alt: 'In-line quality check' },
  { dir: 'assets/Production', basename: '12', alt: 'Production floor, Building B' },
] as const;

const WAREHOUSING = [
  { dir: 'assets/Warehousing', basename: '4', alt: 'Raw material store' },
  { dir: 'assets/Warehousing', basename: '6', alt: 'Fabric racking' },
  { dir: 'assets/Warehousing', basename: '7', alt: 'Finished goods store' },
  { dir: 'assets/Warehousing', basename: '8', alt: 'Carton staging' },
  { dir: 'assets/Warehousing', basename: '9', alt: 'Warehouse aisle' },
  { dir: 'assets/Warehousing', basename: '11', alt: 'Export consolidation' },
] as const;

const DEPARTMENTS = [
  { id: 'cutting', title: 'Cutting area', images: CUTTING, note: 'Precision cutting with advanced CAD technology and automated cutting machines for accurate pattern execution.' },
  { id: 'printing', title: 'Printing facility', images: PRINTING, note: 'Screen printing with multi-color capability.' },
  { id: 'production', title: 'Production', images: PRODUCTION, note: 'State-of-the-art sewing lines with 3,100+ machines and expert operators delivering quality garments.' },
  { id: 'warehousing', title: 'Warehousing', images: WAREHOUSING, note: 'Full warehousing and logistics management for raw materials and finished goods.' },
] as const;
---

<SiteLayout
  title="Facilities | Three Stars Fashion - State-of-the-Art Garment Factories in Egypt"
  description="Tour Three Stars Fashion's state-of-the-art garment manufacturing facilities in Alexandria, Egypt. 10 factories with automated Gerber cutting systems, in-house printing, and 85,000+ daily unit capacity in the Alexandria Free Zone."
  canonical="https://threestarsfashion.com/facilities"
  ogTitle="Facilities | Three Stars Fashion | Egypt Factories"
  ogDescription="State-of-the-art garment factories in Alexandria's Free Zone. Automated Gerber cutting, in-house printing, and 85,000+ daily unit capacity."
  ogUrl="https://threestarsfashion.com/facilities"
  twitterTitle="Facilities | Three Stars Fashion | Egypt Factories"
  twitterDescription="State-of-the-art garment factories in Alexandria's Free Zone. Automated Gerber cutting, in-house printing, and 85,000+ daily unit capacity."
  activeNav="/facilities"
>
  <PageHead
    eyebrow="Our facilities"
    lead="Three buildings,"
    title="one complex, open to audit"
    standfirst="Our manufacturing complex is located in the Alexandria Public Free Zone, providing direct access to Alexandria's commercial port and positioning us at a logistical crossroads between Europe, Africa, and the Middle East — with duty-free export access to the US under QIZ and to the EU under Euro 1."
  />

  <Band surface="page">
    <div class="cards">
      {BUILDINGS.map((b) => (
        <CapabilityCard
          index={b.index}
          title={b.title}
          description={b.description}
          meta={b.meta}
          dir={b.dir}
          basename={b.basename}
          alt={b.alt}
        />
      ))}
    </div>
  </Band>

  <Band surface="navy" grid tight>
    <div class="two">
      <SectionHeading
        size="display-3"
        eyebrow="Alexandria Free Zone"
        lead="Duty-free to"
        title="the US and the EU"
        standfirst="The complex sits inside the Alexandria Public Free Zone with direct access to the commercial port."
        onDark
      />
      <div class="aside">
        <SpecTable caption="Trade access" numericValues={false} rows={TRADE} onDark />
      </div>
    </div>
  </Band>

  {DEPARTMENTS.map((d) => (
    <Band surface={d.id === 'printing' || d.id === 'warehousing' ? 'sunken' : 'page'}>
      <SectionHeading size="display-3" eyebrow="Department" title={d.title} standfirst={d.note} />
      <div class="gallery">
        <Gallery images={d.images} columns={4} />
      </div>
    </Band>
  ))}

  <Band surface="page" tight>
    <SectionHeading
      size="display-3"
      eyebrow="Audit"
      lead="Schedule a"
      title="factory audit or tour"
      standfirst="We welcome sourcing teams and prospective partners to conduct factory audits, evaluate our production capabilities, and tour our facilities firsthand. Unannounced or scheduled."
    />
    <div class="more">
      <Button href="/contact" arrow>Request an audit</Button>
    </div>
  </Band>

  <CalloutBand
    eyebrow="Next step"
    title="Want the compliance pack before you visit?"
    body="Certification documentation and audit reports are available to partners and prospective clients on request."
    actionLabel="Request documentation"
    actionHref="/contact"
    secondaryLabel="Review certifications"
    secondaryHref="/certifications"
  />
</SiteLayout>

<style>
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter) }
  .two {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }
  .aside { display: grid; gap: var(--space-8) }
  .gallery { margin-top: var(--space-12) }
  .more { margin-top: var(--space-10) }

  @media (max-width: 1100px) {
    .cards { grid-template-columns: 1fr }
    .two { grid-template-columns: 1fr; gap: var(--space-10) }
  }
</style>
