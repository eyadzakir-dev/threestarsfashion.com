---
/**
 * Certifications / Compliance. Maps to ComplianceScreen.jsx.
 *
 * CONTENT RESOLUTION, PARITY.md conflict 3: this page now lists ELEVEN
 * certifications. The legacy page showed 8 in its body while faq.html body copy
 * and this page's own meta description both listed 11 — Higg Index, FAMA
 * (Disney) and Inditex Approved Facility were visible in the meta and the FAQ but
 * absent from the certifications page itself. Adopting 11 makes the page agree
 * with the rest of the site.
 *
 * The three additions have no legacy body description, so scopes are written
 * from what the standards are, not invented claims about our status in them.
 *
 * The compliance-pack builder from ComplianceScreen.jsx is deliberately out of
 * scope: it needs a backend, and Tally already handles requests.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Band from '../components/ds/Band.astro';
import PageHead from '../components/ds/PageHead.astro';
import SectionHeading from '../components/ds/SectionHeading.astro';
import CertificationBadge from '../components/ds/CertificationBadge.astro';
import Gallery from '../components/ds/Gallery.astro';
import Button from '../components/ds/Button.astro';
import CalloutBand from '../components/ds/CalloutBand.astro';
import { APPROVALS } from '../data/site';

/** Descriptions for the original 8 are verbatim from legacy/certifications.html. */
const CERTS = [
  { name: 'ISO 9001', scope: 'Quality Management System certification ensuring consistent product quality, customer satisfaction, and continuous improvement across all processes.' },
  { name: 'WRAP', grade: 'Gold', scope: 'Gold-level Worldwide Responsible Accredited Production certification confirming lawful, humane, and ethical manufacturing throughout our facilities.' },
  { name: 'OEKO-TEX Standard 100', scope: 'Certification guaranteeing that our products are tested for harmful substances and are safe for human and environmental health.' },
  { name: 'GRS', scope: 'Global Recycled Standard certification validating recycled content claims and responsible social and environmental practices in production.' },
  { name: 'OCS', scope: 'Organic Content Standard certification for products containing 5% or more organic material, ensuring organic fiber integrity throughout the supply chain.' },
  { name: 'BSCI', scope: 'Business Social Compliance Initiative certification ensuring fair working conditions, ethical labor practices, and respect for human rights.' },
  { name: 'SEDEX', scope: 'Supplier Ethical Data Exchange membership demonstrating ethical supply chain management and transparency in our labor, health, and environmental practices.' },
  { name: 'Better Work', scope: 'ILO-IFC partnership certification ensuring improved working conditions and labor compliance with international standards.' },
  // Three additions, previously meta-only and FAQ-only.
  { name: 'Higg Index', scope: 'Sustainable Apparel Coalition framework for measuring environmental and social performance at facility level.' },
  { name: 'FAMA', scope: 'Disney Facility and Merchandise Authorisation — approval to manufacture Disney-licensed product.' },
  { name: 'Inditex approved facility', scope: 'Vendor approval status under the Inditex supplier programme.' },
] as const;

const AWARDS = [
  { dir: 'assets/Awards and Recognitions', basename: '1', alt: 'Certificate and award' },
  { dir: 'assets/Awards and Recognitions', basename: '2', alt: 'Certificate and award' },
  { dir: 'assets/Awards and Recognitions', basename: '3', alt: 'Certificate and award' },
  { dir: 'assets/Awards and Recognitions', basename: '4', alt: 'Certificate and award' },
  { dir: 'assets/Awards and Recognitions', basename: '5', alt: 'Certificate and award' },
  { dir: 'assets/Awards and Recognitions', basename: '6', alt: 'Certificate and award' },
] as const;
---

<SiteLayout
  title="Certifications | Three Stars Fashion - ISO, WRAP Gold, OEKO-TEX, GRS Certified"
  description="Three Stars Fashion holds ISO 9001, WRAP Gold, OEKO-TEX Standard 100, GRS, OCS, BSCI, SEDEX, Higg Index, and FAMA (Disney) certifications. Inditex Approved Facility. Approved by Walmart, Under Armour, PVH, Primark, and more."
  canonical="https://threestarsfashion.com/certifications"
  ogTitle="Certifications | Three Stars Fashion Group"
  ogDescription="ISO 9001, WRAP Gold, OEKO-TEX, GRS, BSCI & SEDEX certified. Disney FAMA & Inditex Approved. Trusted by Walmart, Under Armour, PVH & Primark."
  ogUrl="https://threestarsfashion.com/certifications"
  twitterTitle="Certifications | Three Stars Fashion Group"
  twitterDescription="ISO 9001, WRAP Gold, OEKO-TEX, GRS, BSCI & SEDEX certified. Disney FAMA & Inditex Approved. Trusted by Walmart, Under Armour, PVH & Primark."
  activeNav="/certifications"
>
  <PageHead
    eyebrow="Compliance"
    lead="Independently audited,"
    title="not marketing claims"
    standfirst="TSF maintains a comprehensive portfolio of international certifications and buyer approvals covering quality management, ethical labor practices, environmental sustainability, and product safety. These certifications are independently audited and represent verified operational standards — not marketing claims."
  />

  <Band surface="page">
    <SectionHeading
      size="display-3"
      eyebrow="Eleven standards"
      lead="Audited,"
      title="documented, current"
      standfirst="Certificates are issued to the facility, not the group — every document names the building it covers."
    />
    <div class="certs">
      {CERTS.map((c) => (
        <CertificationBadge name={c.name} grade={c.grade} scope={c.scope} />
      ))}
    </div>
  </Band>

  <Band surface="navy" grid tight>
    <div class="two">
      <SectionHeading
        size="display-3"
        eyebrow="Buyer approvals"
        lead="Approved by"
        title="brands that audit before they buy"
        onDark
      />
      <p class="approvals">{APPROVALS.join(' · ')}</p>
    </div>
  </Band>

  <Band surface="page">
    <SectionHeading
      size="display-3"
      eyebrow="Awards & recognitions"
      title="On record"
      standfirst="Certificates and industry recognitions held by the group."
    />
    <div class="gallery">
      <Gallery images={AWARDS} columns={3} />
    </div>
  </Band>

  <Band surface="sunken">
    <div class="two">
      <SectionHeading
        size="display-3"
        eyebrow="Our commitment"
        lead="Minimum requirements,"
        title="not targets"
        standfirst="At TSF, certifications reflect our operational commitment to auditable, responsible manufacturing — maintained through continuous monitoring and dedicated compliance teams. We view these standards as minimum requirements that we strive to exceed in every aspect of our operations."
      />
      <p class="prose">
        Our dedicated compliance team continuously monitors and improves our processes,
        ensuring that we not only maintain our certifications but also lead the industry
        in ethical and sustainable manufacturing practices.
      </p>
    </div>
    <div class="more">
      <Button href="/contact" variant="secondary" arrow>Request documentation</Button>
    </div>
  </Band>

  <CalloutBand
    eyebrow="Next step"
    title="Need compliance documentation?"
    body="We are happy to provide detailed certification documentation and compliance reports to our partners and prospective clients."
    actionLabel="Request documentation"
    actionHref="/contact"
    secondaryLabel="Book a factory audit"
    secondaryHref="/facilities"
  />
</SiteLayout>

<style>
  .certs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-12);
  }
  .two {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }
  .approvals {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body);
    color: var(--text-on-dark);
    font-weight: var(--weight-medium);
    padding-top: var(--space-4);
    border-top: var(--border-mid) solid var(--rule-on-dark-mid);
  }
  .prose {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-body);
    max-width: 62ch;
    text-wrap: pretty;
  }
  .gallery { margin-top: var(--space-12) }
  .more { margin-top: var(--space-12) }

  @media (max-width: 1100px) {
    .certs { grid-template-columns: repeat(2, 1fr) }
    .two { grid-template-columns: 1fr; gap: var(--space-10) }
  }
  @media (max-width: 620px) { .certs { grid-template-columns: 1fr } }
</style>
