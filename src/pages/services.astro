---
/**
 * Services / Capability. Maps to CapabilityScreen.jsx.
 *
 * All seven services and their feature lists are preserved from
 * legacy/services.html.
 *
 * CONTENT RESOLUTION, PARITY.md §6: screen printing capacity is RETIRED. Service
 * 03 states the capability and the machine count (6, which is a count, not a
 * capacity claim) and carries NO pieces-per-day figure — neither 6,000+ nor
 * 65,000+ — and no softer quantifier either. The legacy meta description said
 * "6,000+ pcs/day" while five body statements said "65,000+"; rather than pick
 * one, the figure is gone until it can be confirmed against the printing floor.
 * The meta description below is rewritten accordingly.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Band from '../components/ds/Band.astro';
import PageHead from '../components/ds/PageHead.astro';
import SectionHeading from '../components/ds/SectionHeading.astro';
import SpecTable from '../components/ds/SpecTable.astro';
import ServiceCard from '../components/ds/ServiceCard.astro';
import Button from '../components/ds/Button.astro';
import CalloutBand from '../components/ds/CalloutBand.astro';
import { PROGRAMME } from '../data/site';

const SERVICES = [
  {
    number: '01',
    title: 'Precision cutting',
    description: 'Our cutting department utilizes advanced CAD/CAM technology to ensure precise, efficient cutting of fabrics. Every pattern is optimized for minimal waste while maintaining the highest quality standards.',
    features: [
      'Computer-aided design integration',
      'Automated cutting systems',
      'Pattern optimization',
      'Multi-layer cutting capability',
      'Quality inspection at every stage',
    ],
  },
  {
    number: '02',
    title: 'Expert sewing',
    description: 'Our sewing operations run 3,100+ machines across multiple factory buildings, staffed by trained operators delivering consistent quality across activewear, casualwear, uniforms, and underwear categories.',
    features: [
      'Modern sewing machinery',
      'Trained production operators',
      "One of Egypt's largest flat-seam inventories",
      'Strict quality control',
      'High-volume capacity',
    ],
  },
  {
    number: '03',
    title: 'Screen printing',
    // No capacity figure. See the header comment and PARITY.md §6.
    description: 'Our dedicated printing facility runs six advanced screen printing machines, delivering vibrant, durable prints that withstand repeated washing and wear.',
    features: [
      'Six screen printing machines',
      'Multi-color registration',
      'Water-based and plastisol inks',
      'Special effects available',
      'Wash-tested durability',
    ],
  },
  {
    number: '04',
    title: 'Embroidery',
    description: 'Our computerized embroidery department creates intricate designs with precision and consistency. From logos to complex patterns, we deliver professional results every time.',
    features: [
      'Computerized embroidery machines',
      'Multi-head capability',
      'Custom design digitization',
      'Wide thread color selection',
      'Consistent quality output',
    ],
  },
  {
    number: '05',
    title: 'Packing & finishing',
    description: 'The final stage ensures every garment is perfectly finished, pressed, and packaged according to client specifications. We handle all aspects of preparation for shipping.',
    features: [
      'Professional pressing',
      'Quality final inspection',
      'Custom packaging options',
      'Labeling and tagging',
      'Export-ready preparation',
    ],
  },
  {
    number: '06',
    title: 'Quality assurance',
    description: 'Our comprehensive QA process ensures that every garment meets international standards. We maintain strict protocols throughout the entire production chain.',
    features: [
      'In-line quality checks',
      'Final inspection protocols',
      'AQL sampling standards',
      'Customer specification compliance',
      'Continuous improvement processes',
    ],
  },
  {
    number: '07',
    title: 'Product development & sourcing',
    description: 'From initial concept to bulk production, our in-house design and development team supports customers with comprehensive sampling, customization, and global fabric sourcing solutions.',
    features: [
      'In-house design and sampling',
      'Dedicated sourcing office in China',
      '450+ tons cotton/CVC jersey stock',
      'Performance & sustainable fabrics',
      'Custom specification development',
    ],
  },
] as const;

const SOURCING = [
  { label: 'Locally sourced, basic knits', value: '60', unit: '%' },
  { label: 'Greige fabric held in-house', value: '600', unit: 'tons' },
  { label: 'Cotton / CVC jersey stock', value: '450', unit: 'tons' },
  { label: 'Fabric sourcing office', value: 'China', unit: '' },
] as const;
---

<SiteLayout
  title="Services | Three Stars Fashion - Cutting, Sewing, Printing & Embroidery"
  description="Explore Three Stars Fashion's end-to-end garment manufacturing services: precision cutting with CAD/CAM, expert sewing with 3,100+ machines, in-house screen printing, computerized embroidery, quality assurance, and export-ready packing."
  canonical="https://threestarsfashion.com/services"
  ogTitle="Services | Three Stars Fashion | Garment Manufacturing"
  ogDescription="End-to-end garment manufacturing: cutting, sewing, screen printing, embroidery & packing. 3,100+ machines, 85,000+ units daily capacity."
  ogUrl="https://threestarsfashion.com/services"
  twitterTitle="Services | Three Stars Fashion | Garment Manufacturing"
  twitterDescription="End-to-end garment manufacturing: cutting, sewing, screen printing, embroidery & packing. 3,100+ machines, 85,000+ units daily capacity."
  activeNav="/services"
>
  <PageHead
    eyebrow="Capability"
    lead="Seven services,"
    title="one production line of record"
    standfirst="TSF offers a complete range of garment manufacturing services — from cutting and sewing through embellishment, finishing, quality assurance, and product development. Our integrated facilities and experienced production teams ensure consistent output at high volumes while maintaining international quality and compliance standards."
  />

  <Band surface="page">
    <div class="services">
      {SERVICES.map((s) => (
        <ServiceCard
          number={s.number}
          title={s.title}
          description={s.description}
          features={s.features}
        />
      ))}
    </div>
  </Band>

  <Band surface="sunken">
    <div class="two">
      <SectionHeading
        size="display-3"
        eyebrow="Programme"
        lead="About 30 days"
        title="on single jersey"
        standfirst="Single jersey turns around in approximately 30 days because over 600 tons of greige fabric is held in-house for immediate production. For most locally sourced fabrics, including jersey and fleece for knit garments, the lead time is approximately 45 days from order confirmation to delivery."
      />
      <div class="aside">
        <SpecTable caption="Programme parameters" rows={PROGRAMME} />
      </div>
    </div>
  </Band>

  <Band surface="page">
    <div class="two">
      <SectionHeading
        size="display-3"
        eyebrow="Materials"
        lead="Local network,"
        title="international specialty"
        standfirst="We locally source approximately 60% of our production requirements for basic knit fabrics through our strong domestic supplier network. Woven fabrics and specialty performance materials are sourced internationally through our dedicated fabric sourcing and quality office in China."
      />
      <div class="aside">
        <SpecTable caption="Sourcing" numericValues={false} rows={SOURCING} />
      </div>
    </div>
    <div class="more">
      <Button href="/facilities" variant="secondary" arrow>Where this happens</Button>
    </div>
  </Band>

  <CalloutBand
    eyebrow="Next step"
    title="Have a tech pack ready?"
    body="Send it with volumes and target ex-factory dates. You will get a capacity answer and a sampling plan."
    actionLabel="Submit an inquiry"
    actionHref="/contact"
    secondaryLabel="Read the FAQ"
    secondaryHref="/faq"
  />
</SiteLayout>

<style>
  .services { display: grid; gap: var(--space-12) }
  .two {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }
  .aside { display: grid; gap: var(--space-8) }
  .more { margin-top: var(--space-12) }

  @media (min-width: 900px) {
    .services { grid-template-columns: repeat(2, 1fr); gap: var(--space-12) var(--space-16) }
  }
  @media (max-width: 1100px) {
    .two { grid-template-columns: 1fr; gap: var(--space-10) }
  }
</style>
