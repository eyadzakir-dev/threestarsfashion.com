---
// Footer. Deep navy, hairline rules, the address block as a record.
// Every claim here is in PARITY.md §2 and must not drift.
import MediaSlot from '../MediaSlot.astro';

const LINKEDIN = 'https://www.linkedin.com/company/three-stars-fashion-group/posts/?feedView=all';

const COLUMNS = [
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About Us' },
      { href: '/services', label: 'Capability' },
      { href: '/facilities', label: 'Our Facilities' },
    ],
  },
  {
    title: 'For buyers',
    links: [
      { href: '/certifications', label: 'Certifications' },
      { href: '/logistics', label: 'Logistics' },
      { href: '/faq', label: 'FAQ' },
      { href: '/contact', label: 'Submit an inquiry' },
    ],
  },
  {
    title: 'Group',
    links: [
      { href: '/about', label: 'Three Stars Apparels' },
      { href: '/about', label: 'Golden Stars Textile' },
      { href: 'https://gpl.com.eg/', label: 'Green Point Logistics', external: true },
    ],
  },
];
---
<footer class="ftr" id="contact">
  <div class="ftr__inner">
    <div class="ftr__top">
      <div class="ftr__brand">
        <a href="/" class="ftr__logo" aria-label="Three Stars Fashion — home">
          <MediaSlot
            dir="assets/Brands"
            basename="tsflogo"
            alt=""
            aspectRatio="1 / 1"
            fit="contain"
            posterOnly
            class="ftr__mark"
          />
          <span class="ftr__wordmark">Three Stars Fashion</span>
        </a>
        <p class="ftr__tagline">
          Vertically integrated garment manufacturing in the Alexandria Public
          Free Zone since 2008.
        </p>
        <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class="ftr__social" aria-label="Three Stars Fashion on LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
          </svg>
        </a>
      </div>

      {COLUMNS.map((col) => (
        <nav class="ftr__col" aria-label={col.title}>
          <p class="ftr__col-title">{col.title}</p>
          <ul class="ftr__list">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener noreferrer' : undefined}
                >{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <div class="ftr__col ftr__col--address">
        <p class="ftr__col-title">Factory / Head Office</p>
        <address class="ftr__address">
          Street No. 7 &ndash; Public Free Zone Amreya<br />
          Alexandria, Egypt<br />
          Postal Code: 23512
        </address>
        <p class="ftr__contact">
          <a href="tel:+20234500550">+2 03 4500550</a><br />
          <a href="tel:+201141333589">+2 011 41333589</a><br />
          <a href="mailto:info@tsf.com.eg">info@tsf.com.eg</a>
        </p>
      </div>
    </div>

    <div class="ftr__bottom">
      <p>&copy; 2026 Three Stars Fashion. All rights reserved.</p>
      <a href="/privacy-policy">Privacy Policy</a>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--surface-navy-deep);
    color: var(--text-on-dark-body);
    border-top: var(--keyline-accent);
  }
  .ftr__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--section-y-tight) var(--page-pad) var(--space-8);
  }
  .ftr__top {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr) 1.2fr;
    gap: var(--space-10);
    padding-bottom: var(--space-12);
    border-bottom: var(--border-hair) solid var(--rule-on-dark);
  }

  .ftr__brand { display: grid; gap: var(--space-4); align-content: start }
  .ftr__logo { display: flex; align-items: center; gap: var(--space-3); text-decoration: none }
  .ftr__logo:hover { text-decoration: none }
  .ftr :global(.media-slot.ftr__mark) { width: 36px; background: none }
  .ftr :global(.media-slot.ftr__mark .media-slot__poster) { filter: none }

  .ftr__wordmark {
    font-family: var(--font-display);
    font-size: var(--fs-heading-2);
    font-weight: var(--weight-semibold);
    color: var(--text-on-dark);
  }
  .ftr__tagline { font-size: var(--fs-body-sm); line-height: var(--lh-body); max-width: 34ch }
  .ftr__social { color: var(--text-on-dark-muted); width: max-content }
  .ftr__social:hover { color: var(--text-on-dark) }

  .ftr__col-title {
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-on-dark-label);
    margin-bottom: var(--space-4);
  }
  .ftr__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3) }
  .ftr__list a,
  .ftr__contact a {
    font-size: var(--fs-body-sm);
    color: var(--text-on-dark-body);
    text-decoration: none;
  }
  .ftr__list a:hover,
  .ftr__contact a:hover { color: var(--text-on-dark); text-decoration: underline; text-underline-offset: 3px }

  .ftr__address,
  .ftr__contact {
    font-style: normal;
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
  }
  .ftr__contact { margin-top: var(--space-4) }

  .ftr__bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-top: var(--space-6);
    font-size: var(--fs-caption);
    color: var(--text-on-dark-muted);
  }
  .ftr__bottom a { color: var(--text-on-dark-muted) }
  .ftr__bottom a:hover { color: var(--text-on-dark) }

  @media (max-width: 1100px) {
    .ftr__top { grid-template-columns: 1fr 1fr 1fr }
    .ftr__brand { grid-column: 1 / -1 }
  }
  @media (max-width: 660px) {
    .ftr__top { grid-template-columns: 1fr }
  }
</style>
