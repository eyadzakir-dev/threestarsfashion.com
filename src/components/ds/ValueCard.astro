---
// Value card. The design system puts an icon in a 48px hairline well; this uses
// a red keyline and a label instead, which avoids pulling in a 20-glyph icon set
// for four cards and keeps the section purely typographic.
import Eyebrow from './Eyebrow.astro';

interface Props {
  label: string;
  title: string;
  body: string;
}
const { label, title, body } = Astro.props;
---
<article class="val">
  <Eyebrow tone="accent">{label}</Eyebrow>
  <h3 class="val__title">{title}</h3>
  <p class="val__body">{body}</p>
</article>

<style>
  .val {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: var(--border-mid) solid var(--rule-strong);
    transition: border-color var(--dur-fast) step-end;
  }
  .val:hover { border-top-color: var(--rule-accent) }
  .val__title {
    font-family: var(--font-display);
    font-size: var(--fs-heading-2);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-heading);
    color: var(--text-display);
  }
  .val__body {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--text-body);
    text-wrap: pretty;
  }
</style>
