---
/**
 * MediaSlot — every visual position on the site goes through this component.
 * No bare <img> or <video> in section markup, ever.
 *
 * It always renders the poster, and emits a <video> ONLY if a loop.mp4 exists in
 * the slot directory at build time. That is the whole point: real footage gets
 * added later by dropping a file at the path, with no code change. A position
 * with no media at all renders an empty framed placeholder rather than
 * collapsing the layout — the deliberate state of the `facilities` slot, which
 * is awaiting real footage and must never be filled with generated facility
 * imagery.
 *
 * Two addressing modes:
 *   slotName            -> public/assets/slots/{slotName}/{basename}.*
 *   dir                 -> public/{dir}/{basename}.*   (any path under public/)
 * The second exists so the legacy factory photography can also render through
 * this component instead of a bare <img>.
 */
import { resolveMedia } from '../lib/media';

interface Props {
  /** Named slot under assets/slots/. Mutually exclusive with `dir`. */
  slotName?: string;
  /** Explicit directory under public/, e.g. "assets/Buildings". */
  dir?: string;
  /** File stem. Defaults to "poster" for slots. */
  basename?: string;
  /** CSS aspect-ratio value. Reserves space so nothing shifts. */
  aspectRatio?: string;
  alt: string;
  /**
   * Render the poster only, never the video, even if loop.mp4 exists.
   * Required wherever many positions share a viewport: six autoplaying loops in
   * one pinned section (ProcessScroll) would be brutal on mobile, and a future
   * loop.mp4 drop must not silently turn them all on.
   */
  posterOnly?: boolean;
  /** Above-the-fold positions should not lazy-load — it delays LCP. */
  eager?: boolean;
  /** Applies the quieter photography treatment (--img-filter-quiet). */
  quiet?: boolean;
  /** object-fit override; "contain" for logos. */
  fit?: 'cover' | 'contain';
  class?: string;
}

const {
  slotName, dir, basename = 'poster', aspectRatio = '16 / 9', alt,
  posterOnly = false, eager = false, quiet = false, fit = 'cover',
  class: className = '',
} = Astro.props;

if (!slotName && !dir) throw new Error('MediaSlot needs either slotName or dir');

const mediaDir = dir ?? `assets/slots/${slotName}`;
const m = await resolveMedia(mediaDir, basename);

const hasVideo = !posterOnly && (m.mp4 !== null || m.webm !== null);
const hasPoster = m.fallback !== null;
const state = hasVideo ? 'video' : hasPoster ? 'poster' : 'empty';
---

<figure
  class:list={['media-slot', quiet && 'media-slot--quiet', `media-slot--${fit}`, className]}
  style={`--slot-aspect: ${aspectRatio};`}
  data-slot={slotName ?? mediaDir}
  data-state={state}
>
  {hasPoster && (
    <picture>
      {m.avif && <source srcset={m.avif} type="image/avif" />}
      {m.webp && <source srcset={m.webp} type="image/webp" />}
      <img
        src={m.fallback}
        alt={alt}
        width={m.width ?? undefined}
        height={m.height ?? undefined}
        loading={eager ? 'eager' : 'lazy'}
        decoding={eager ? 'sync' : 'async'}
        fetchpriority={eager ? 'high' : 'auto'}
        class="media-slot__poster"
      />
    </picture>
  )}

  {/*
    No `poster` attribute: the <picture> above already renders the poster
    underneath this video, so a poster here downloads the same image a SECOND
    time in a different format. Measured on the homepage: 176 KB of AVIF via
    <picture> plus 170 KB of WebP via poster, for one visible image.
  */}
  {hasVideo && (
    <video
      class="media-slot__video"
      muted
      loop
      playsinline
      autoplay
      preload="none"
      aria-hidden="true"
      tabindex="-1"
    >
      {m.webm && <source src={m.webm} type="video/webm" />}
      {m.mp4 && <source src={m.mp4} type="video/mp4" />}
    </video>
  )}

  {!hasPoster && !hasVideo && (
    <div class="media-slot__empty" role="presentation" aria-hidden="true"></div>
  )}
</figure>

<style>
  .media-slot {
    position: relative;
    display: block;
    margin: 0;
    aspect-ratio: var(--slot-aspect);
    overflow: hidden;
    background: var(--surface-navy-deep);
    /* Contain stacking: without this the video's layer escaped the figure and
       painted over the hero copy and its protection scrim. */
    isolation: isolate;
  }

  .media-slot__poster,
  .media-slot__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--img-filter);
  }
  .media-slot--contain .media-slot__poster,
  .media-slot--contain .media-slot__video { object-fit: contain }

  .media-slot--quiet .media-slot__poster,
  .media-slot--quiet .media-slot__video { filter: var(--img-filter-quiet) }

  /* The video already paints above the poster by DOM order. It must NOT carry a
     z-index: that created a layer which escaped the figure and covered the hero
     headline and CTA. */

  /* Awaiting-real-media: the engineering grid field, not a broken image.
     Reads as restrained rather than empty. */
  .media-slot__empty {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--rule-on-dark) 1px, transparent 1px),
      linear-gradient(to bottom, var(--rule-on-dark) 1px, transparent 1px);
    background-size: 80px 80px;
  }

  /* Reduced motion: hide the video and let the poster show. A display:none
     video does not autoplay, so this needs no JavaScript. The :has() guard
     keeps a video-only position visible rather than showing nothing —
     degrading must never hide content. */
  @media (prefers-reduced-motion: reduce) {
    .media-slot[data-state='video'] .media-slot__video { display: none }
    .media-slot[data-state='video']:not(:has(.media-slot__poster)) .media-slot__video {
      display: block;
    }
  }
</style>
