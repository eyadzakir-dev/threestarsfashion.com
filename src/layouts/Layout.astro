---
// Step 2 lift-and-shift layout. The header, fullscreen menu and footer are
// reproduced verbatim from the legacy HTML, which was byte-identical across all
// nine pages except two things: which .menu-link carries `active`, and the
// id="contact" on index's <footer>. Both are props.
//
// Head tag ORDER matches the legacy files exactly. Do not reorder or "improve"
// anything here — steps 3+ replace this wholesale; step 2 only moves it.
// Asset hrefs stay relative because every page is emitted at the root
// (build.format: 'file'), so they resolve identically.

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogTitle: string;
  ogDescription: string;
  ogUrl: string;
  twitterTitle: string;
  twitterDescription: string;
  activeNav?: string | null;
  bodyClass?: string | null;
  footerId?: string | null;
  pagesCss?: boolean;
}

const {
  title, description, canonical, ogTitle, ogDescription, ogUrl,
  twitterTitle, twitterDescription,
  activeNav = null, bodyClass = null, footerId = null, pagesCss = true,
} = Astro.props;

const nav = (href: string) => `menu-link${activeNav === href ? ' active' : ''}`;
const OG_IMAGE = 'https://threestarsfashion.com/assets/og-image.jpg';
---

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="assets/favicon/favicon-96x96.png" sizes="96x96">
    <link rel="icon" type="image/svg+xml" href="assets/favicon/favicon.svg">
    <link rel="shortcut icon" href="assets/favicon/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="assets/favicon/apple-touch-icon.png">
    <link rel="manifest" href="assets/favicon/site.webmanifest">
    <link rel="canonical" href={canonical}>
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Three Stars Fashion Group">
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={ogDescription}>
    <meta property="og:url" content={ogUrl}>
    <meta property="og:image" content={OG_IMAGE}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={twitterTitle}>
    <meta name="twitter:description" content={twitterDescription}>
    <meta name="twitter:image" content={OG_IMAGE}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="styles.css">
    {pagesCss && <link rel="stylesheet" href="pages.css" />}
    <slot name="head" />
</head>

<body class={bodyClass}>
    <!-- Navigation -->
    <header class="header" id="header">
        <nav class="nav">
            <a href="/" class="logo">
                <img src="assets/Brands/tsflogo.png" alt="Three Stars Fashion" class="logo-img" width="40" height="40">
                <span class="logo-company-name">Three Stars Fashion</span>
            </a>
            <div class="nav-right">
                <a href="/contact" class="header-cta">Submit an Inquiry</a>
                <a href="https://www.linkedin.com/company/three-stars-fashion-group/posts/?feedView=all" target="_blank"
                    class="social-link" aria-label="LinkedIn">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path
                            d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
                    </svg>
                </a>
                <button class="menu-open-btn" id="menuOpenBtn" aria-label="Open menu">
                    <span class="menu-text">MENU</span>
                    <span class="hamburger">
                        <span class="line"></span>
                        <span class="line"></span>
                        <span class="line"></span>
                    </span>
                </button>
            </div>
        </nav>
    </header>

    <!-- Full Screen Menu -->
    <div class="fullscreen-menu" id="fullscreenMenu">
        <button class="menu-close-btn" id="menuCloseBtn" aria-label="Close menu">
            <span class="menu-text">CLOSE</span>
            <span class="close-icon">×</span>
        </button>
        <div class="menu-content">
            <div class="menu-visual">
                <div class="menu-visual-bg"></div>
            </div>
            <div class="menu-links">
                <nav class="menu-nav">
                    <a href="/" class={nav('/')}>
                        <span class="link-number">01</span>
                        <span class="link-text">Home</span>
                    </a>
                    <a href="/about" class={nav('/about')}>
                        <span class="link-number">02</span>
                        <span class="link-text">About Us</span>
                    </a>
                    <a href="/services" class={nav('/services')}>
                        <span class="link-number">03</span>
                        <span class="link-text">Services</span>
                    </a>
                    <a href="/facilities" class={nav('/facilities')}>
                        <span class="link-number">04</span>
                        <span class="link-text">Our Facilities</span>
                    </a>
                    <a href="/certifications" class={nav('/certifications')}>
                        <span class="link-number">05</span>
                        <span class="link-text">Certifications</span>
                    </a>
                    <a href="/logistics" class={nav('/logistics')}>
                        <span class="link-number">06</span>
                        <span class="link-text">Logistics</span>
                    </a>
                    <a href="/faq" class={nav('/faq')}>
                        <span class="link-number">07</span>
                        <span class="link-text">FAQ</span>
                    </a>
                    <a href="/contact" class={nav('/contact')}>
                        <span class="link-number">08</span>
                        <span class="link-text">Contact</span>
                    </a>
                </nav>
                <div class="menu-footer">
                    <div class="menu-contact">
                        <p>info@tsf.com.eg</p>
                        <p>+2 03 4500550</p>
                    </div>
                    <div class="menu-location">
                        <p>Alexandria Free Zone</p>
                        <p>Egypt</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <slot />

    <!-- Footer -->
    <footer class="footer" id={footerId}>
        <div class="gradient-divider"></div>
        <div class="footer-content">
            <div class="footer-main">
                <div class="footer-brand">
                    <a href="/" class="footer-logo">
                        <img src="assets/Brands/tsflogo.png" alt="Three Stars Fashion" class="footer-logo-img">
                        <span class="footer-company-name">Three Stars Fashion</span>
                    </a>
                </div>
                <div class="footer-nav">
                    <div class="footer-nav-group">
                        <a href="/">Home</a>
                        <a href="/about">About Us</a>
                        <a href="/services">Services</a>
                        <a href="/facilities">Our Facilities</a>
                    </div>
                    <div class="footer-nav-group">
                        <a href="/certifications">Certifications</a>
                        <a href="/logistics">Logistics</a>
                        <a href="/faq">FAQ</a>
                        <a href="/contact">Contact Us</a>
                    </div>
                </div>
                <div class="footer-social">
                    <a href="https://www.linkedin.com/company/three-stars-fashion-group/posts/?feedView=all"
                        target="_blank" aria-label="LinkedIn">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path
                                d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
                        </svg>
                    </a>
                </div>
            </div>
            <div class="footer-info">
                <div class="footer-contact">
                    <p><strong>Factory / Head Office:</strong></p>
                    <p>Street No. 7 - Public Free Zone Amreya</p>
                    <p>Alexandria, Egypt | Postal Code: 23512</p>
                    <p>Tel: +2 03 4500550 | +2 011 41333589</p>
                    <p>Email: <a href="mailto:info@tsf.com.eg">info@tsf.com.eg</a></p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Three Stars Fashion. All rights reserved.</p>
                <a href="/privacy-policy">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <script is:inline src="script.js"></script>
    <slot name="tail" />
</body>

</html>
